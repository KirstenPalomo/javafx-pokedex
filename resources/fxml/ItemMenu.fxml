<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pokedex.controllers.ItemMenuController">
   <children>
      <ImageView fitHeight="400.0" fitWidth="607.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../assets/itemMenu.png" />
         </image>
      </ImageView>
      <Button fx:id="viewBtn" layoutX="80.0" layoutY="221.0" mnemonicParsing="false" onAction="#handleView" opacity="0.0" prefHeight="25.0" prefWidth="184.0" text="Button" />
      <Button fx:id="searchBtn" layoutX="325.0" layoutY="221.0" mnemonicParsing="false" onAction="#handleSearch" opacity="0.0" prefHeight="25.0" prefWidth="184.0" text="Button" />
      <Button fx:id="backBtn" layoutX="278.0" layoutY="353.0" mnemonicParsing="false" onAction="#handleBack" opacity="0.0" prefHeight="25.0" prefWidth="46.0" text="Button" />
   </children>
</AnchorPane>
