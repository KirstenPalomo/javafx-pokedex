<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pokedex.controllers.TrainerMenuController">
   <children>
      <ImageView fitHeight="400.0" fitWidth="600.0" layoutX="1.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../assets/trainerMenu.png" />
         </image>
      </ImageView>
      <Button fx:id="addBtn" layoutX="231.0" layoutY="193.0" mnemonicParsing="false" onAction="#handleAdd" opacity="0.0" prefHeight="25.0" prefWidth="139.0" text="Button" />
      <Button fx:id="searchBtn" layoutX="380.0" layoutY="256.0" mnemonicParsing="false" onAction="#handleSearch" opacity="0.0" prefHeight="25.0" prefWidth="139.0" text="Button" />
      <Button fx:id="viewBtn" layoutX="71.0" layoutY="256.0" mnemonicParsing="false" onAction="#handleViewAll" opacity="0.0" prefHeight="25.0" prefWidth="139.0" text="Button" />
      <Button fx:id="backBtn" layoutX="276.0" layoutY="352.0" mnemonicParsing="false" onAction="#handleBack" opacity="0.0" prefHeight="25.0" prefWidth="51.0" text="Button" />
   </children>
</AnchorPane>
