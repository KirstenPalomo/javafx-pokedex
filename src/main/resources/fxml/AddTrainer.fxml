      <TextField fx:id="nameField" layoutX="237.0" layoutY="146.0" prefHeight="25.0" prefWidth="128.0" />
      <TextField fx:id="hometownField" layoutX="237.0" layoutY="280.0" prefHeight="25.0" prefWidth="128.0" />
      <TextArea fx:id="descriptionArea" layoutX="399.0" layoutY="147.0" prefHeight="161.0" prefWidth="128.0" />
      <Button fx:id="submitButton" layoutX="263.0" layoutY="354.0" mnemonicParsing="false" onAction="#handleSubmit" opacity="0.0" prefHeight="25.0" prefWidth="76.0" text="Button" />
