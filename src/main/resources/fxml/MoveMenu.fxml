<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21.0.4" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pokedex.controllers.MoveMenuController">
   <children>
      <ImageView fitHeight="400.0" fitWidth="600.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../assets/moveMenu.png" />
         </image>
      </ImageView>
      <Button fx:id="addBtn" layoutX="227.0" layoutY="195.0" mnemonicParsing="false" onAction="#handleAddMove" opacity="0.0" prefHeight="31.0" prefWidth="144.0" text="Button" />
      <Button fx:id="viewBtn" layoutX="49.0" layoutY="256.0" mnemonicParsing="false" onAction="#handleViewAll" opacity="0.0" prefHeight="31.0" prefWidth="187.0" text="Button" />
      <Button fx:id="searchBtn" layoutX="371.0" layoutY="256.0" mnemonicParsing="false" onAction="#handleSearch" opacity="0.0" prefHeight="31.0" prefWidth="162.0" text="Button" />
      <Button fx:id="backBtn" layoutX="276.0" layoutY="356.0" mnemonicParsing="false" onAction="#handleBack" opacity="0.0" prefHeight="25.0" prefWidth="49.0" text="Button" />
   </children>
</AnchorPane>
