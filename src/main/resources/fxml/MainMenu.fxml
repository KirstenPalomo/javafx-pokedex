<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21.0.4" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pokedex.controllers.MainMenuController">
   <children>
      <ImageView fitHeight="400.0" fitWidth="602.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../assets/mainmenu.png" />
         </image>
      </ImageView>
      <Button fx:id="pokemonBtn" layoutX="248.0" layoutY="177.0" mnemonicParsing="false" onAction="#goToPokemon" opacity="0.0" prefHeight="34.0" prefWidth="104.0" text="Button" />
      <Button fx:id="movesBtn" layoutX="248.0" layoutY="223.0" mnemonicParsing="false" onAction="#goToMoves" opacity="0.0" prefHeight="21.0" prefWidth="105.0" text="Button" />
      <Button fx:id="itemsBtn" layoutX="252.0" layoutY="261.0" mnemonicParsing="false" onAction="#goToItems" opacity="0.0" prefHeight="36.0" prefWidth="98.0" text="Button" />
      <Button fx:id="trainerBtn" layoutX="251.0" layoutY="304.0" mnemonicParsing="false" onAction="#goToTrainerMenu" opacity="0.0" prefHeight="28.0" prefWidth="99.0" text="Button" />
      <Button fx:id="exitBtn" layoutX="278.0" layoutY="351.0" mnemonicParsing="false" onAction="#exitApp" opacity="0.0" prefHeight="28.0" prefWidth="48.0" text="Button" />
   </children>
</AnchorPane>
