<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pokedex.controllers.PokemonMenuController">
   <children>
      <AnchorPane layoutX="-1.0" layoutY="-2.0" prefHeight="400.0" prefWidth="600.0">
         <children>
            <ImageView fitHeight="401.0" fitWidth="602.0" layoutY="1.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../assets/pokemonMenu.png" />
               </image>
            </ImageView>
            <Button fx:id="addBtn" layoutX="226.0" layoutY="195.0" mnemonicParsing="false" onAction="#handleAddPokemon" opacity="0.0" prefHeight="31.0" prefWidth="147.0" text="Button" />
            <Button fx:id="viewBtn" layoutX="47.0" layoutY="258.0" mnemonicParsing="false" onAction="#handleViewAll" opacity="0.0" prefHeight="31.0" prefWidth="192.0" text="Button" />
            <Button fx:id="searchBtn" layoutX="366.0" layoutY="260.0" mnemonicParsing="false" onAction="#handleSearchPokemon" opacity="0.0" prefHeight="26.0" prefWidth="173.0" text="Button" />
            <Button fx:id="backBtn" layoutX="274.0" layoutY="358.0" mnemonicParsing="false" onAction="#handleBack" opacity="0.0" prefHeight="10.0" prefWidth="53.0" text="Button" />
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
